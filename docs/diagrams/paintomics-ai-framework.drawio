        </mxCell>
        <mxCell id="leg_1. t7" value="Guard / safety net" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="leg_1. ">
          <mxGeometry x="54" y="198" width="266" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p1note" value="Reading this page&#xa;&#xa;• Consent is the gate: /ai_interpret_initiate refuses a job whose record says aiConsent=false, and every outward-facing route re-checks it.&#xa;• The long run is asynchronous: the route only enqueues; a PySiQ worker thread runs the whole interpretation and writes progress to Mongo,&#xa;   and the browser learns about it only by polling /ai_interpret_status.&#xa;• Chat and per-pathway explanations are the opposite: they run inside the HTTP request through llm_client.py, never through the queue or the SDK.&#xa;• agent.py is orchestration only. Everything else — context, clusters, prompts, tools, PubMed, verification — lives in the green modules,&#xa;   which is what lets the AgentEvolve benchmark harness replay a run outside Flask.&#xa;• Two clients of the same gateway: the SDK shim (pipeline) and llm_client.py (chat, per-pathway, quote lookups)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="500" y="1560" width="860" height="220" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="2._One_interpretation_run" name="2. One interpretation run">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="One AI interpretation run, phase by phase" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="120" y="-110" width="1400" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t2b" value="Page 2 of 4 · agent.py::_run_async — left column: setup and evidence gathering · right column: writing and checking" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="120" y="-66" width="1400" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="g0" value="5 %&#xa;extracting" style="text;html=1;verticalAlign=middle;fontSize=10;fontColor=#666666;align=right;" vertex="1" parent="1">
          <mxGeometry x="20" y="65" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g1" value="10 %&#xa;extracting" style="text;html=1;verticalAlign=middle;fontSize=10;fontColor=#666666;align=right;" vertex="1" parent="1">
          <mxGeometry x="20" y="475" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="15 %&#xa;searching_pubmed" style="text;html=1;verticalAlign=middle;fontSize=10;fontColor=#666666;align=right;" vertex="1" parent="1">
          <mxGeometry x="20" y="605" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g3" value="25 %&#xa;searching_pubmed" style="text;html=1;verticalAlign=middle;fontSize=10;fontColor=#666666;align=right;" vertex="1" parent="1">
          <mxGeometry x="20" y="715" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g4" value="45 %&#xa;interpreting" style="text;html=1;verticalAlign=middle;fontSize=10;fontColor=#666666;align=right;" vertex="1" parent="1">
          <mxGeometry x="20" y="1265" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g5" value="78 %&#xa;synthesizing" style="text;html=1;verticalAlign=middle;fontSize=10;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="1540" y="630" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g6" value="85 %&#xa;verifying" style="text;html=1;verticalAlign=middle;fontSize=10;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="1540" y="1185" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g7" value="100 %&#xa;done" style="text;html=1;verticalAlign=middle;fontSize=10;fontColor=#666666;align=left;" vertex="1" parent="1">
          <mxGeometry x="1540" y="1495" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="P0" value="&lt;b&gt;run_ai_agent()  →  run_agent_workflow()&lt;/b&gt;&#xa;save_progress('extracting', 5 %) · _Heartbeat(30 s) · semaphore (2 concurrent runs)&#xa;asyncio.wait_for(_run_async, AI_MAX_RUN_SECONDS = 2700 s)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="120" y="40" width="620" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="P_ctx" value="&lt;b&gt;Build the data context&lt;/b&gt;   ·   no LLM&#xa;build_pathway_context(top AI_MAX_PATHWAYS = 15 by combined p) · build_gene_symbol_whitelist&#xa;triage_pathways → major / minor · build_cross_omic_matrix(30 genes) · build_key_regulators_block(30)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="120" y="170" width="620" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="P_dec" value="AI_CLUSTER_MODE = 1 ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="320" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="P_clu" value="&lt;b&gt;clusters.build_partition()&lt;/b&gt;   ·   deterministic, no LLM&#xa;canonical feature identity (union-find over omicsValues inputName, joins KEGG+Reactome clones)&#xa;→ Sorensen-Dice matrix → average-linkage cut at Dice 0.25, cap 10 → C01..Cnn&#xa;isolates attach as satellites (mean Dice 0.10) · standalone · 'further' pool · hub features flagged" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="300" width="620" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="P_clu2" value="pathways = EVERY significant pathway the Step 3 network draws (p &lt;= 0.05, &lt;= 150 nodes),&#xa;kept in global rank order — clustering decides what is discussed together, never the emphasis.&#xa;Phase 1 triage is skipped: the partition already chose the subject matter." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="450" width="620" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="P1" value="&lt;b&gt;Phase 1 — Triage&lt;/b&gt;   ·   1 LLM call&#xa;Triage Agent (output_type=TriageResult) picks up to 15 pathways from the ranked list.&#xa;The picks are logged; the pathway set downstream is the ranked list itself." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="120" y="450" width="620" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="P2" value="&lt;b&gt;Phase 2 — Search planning&lt;/b&gt;   ·   1 LLM call&#xa;Search Planner (output_type=SearchPlan) turns major pathways + cross-omic matrix +&#xa;gene whitelist into &lt;= AI_MAX_SEARCH_TASKS (12) PubMed queries with rationales." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="120" y="580" width="620" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="P3h" value="&lt;b&gt;Phase 3 — Literature retrieval&lt;/b&gt;   ·   1 LLM call per search task" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="120" y="710" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="P3a" value="3a  backfill queries — deterministic&#xa;per-cluster gene-anchored queries (cluster mode) or up to 3 angles per uncovered&#xa;pathway; whole list capped at AI_SDK_BACKFILL_MAX_TASKS = 45" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="140" y="760" width="580" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="P3b" value="3b  ESearch per task, concurrently (semaphore), 5 hits each; failures dropped" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="140" y="844" width="580" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="P3c" value="3c  EFetch abstracts for all unique PMIDs in chunks of 200 — N+1 calls, not 2N" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="140" y="902" width="580" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="P3d" value="3d  Paper Filter agent, one call per task (output_type=RelevantPMIDs), keeps &lt;= 3;&#xa;malformed answer falls back to the top hits" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="140" y="960" width="580" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="P3e" value="3e  dedup by PMID → global ref_index 1..n, merge pathway attributions" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="140" y="1044" width="580" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="P3f" value="3f  full-text upgrade per paper: PMC XML → Europe PMC → abstract only.&#xa;JATS sections classified; Methods/Materials/Supplementary dropped; 12 000 chars each" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="140" y="1102" width="580" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="P4" value="&lt;b&gt;Phase 4 — Batched interpretation&lt;/b&gt;   ·   1 tool-loop run per batch, all batches in parallel&#xa;plain path: batches of AI_PATHWAYS_PER_BATCH = 5 pathways, Pathway Interpreter with DATA_TOOLS, &lt;= 8 turns&#xa;cluster path: build_units → pack_units(&lt;= 8 pathways, a cluster is never split), 6 batches at a time;&#xa;a batch holding a top-15 pathway gets the tool loop (5 turns), the rest get one single-shot call&#xa;each batch prompt carries its pathways' data + &lt;= 10 attributed papers + shared gene core + regulators" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="120" y="1230" width="620" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="P5h" value="&lt;b&gt;Phase 5 — Synthesis&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="900" y="620" width="620" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="P5a" value="5a  Report Writer draft — 1 LLM call, bounded at 600 s&#xa;batch reports + master reference list + pathway table (+ cluster map) → whole report" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="920" y="670" width="580" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="P5b0" value="5b  optional completeness gap-fill — AI_SDK_GAP_FILL=0, off by default" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="920" y="750" width="580" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="P5c" value="5c  citation top-up: if fewer than 22 papers are cited, one more Report Writer pass over&#xa;the uncited papers; kept only if the report stays long and citations went up" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="920" y="808" width="580" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="P5d" value="5d  append the deterministic tables: '## Enriched Pathway Summary'&#xa;or, in cluster mode, '## Pathway Clusters' + the 'how to read this' note" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="920" y="888" width="580" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="P5e" value="5e  quote collection — 1 LLM call per cited paper: the verbatim sentence that&#xa;supports the claim, snapped back to the source text" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="920" y="968" width="580" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="P5f" value="5f  render_references_section: the model's References are discarded and rebuilt from&#xa;paper metadata + Cited Text + 'Cited from: abstract / full text (results)'" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="920" y="1048" width="580" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="P5v" value="&lt;b&gt;Phase 5b — verify → correct loop&lt;/b&gt;   ·   up to AI_MAX_VERIFICATION_ITERATIONS = 3 rounds&#xa;every citation with a quote → Claim Verifier (run_hedged 45 s x2) which may call search_paper_text /&#xa;fetch_paper_section on the paper index, and answers a JSON verdict {text_match, supports_claim, ...}&#xa;failures → one Report Writer correction rewrite (bounded 600 s) → re-quote, re-render, loop&#xa;stops early when nothing failed or when a round makes no progress" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="900" y="1150" width="620" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="P6" value="&lt;b&gt;Phase 6 — the programmatic safety net&lt;/b&gt;   ·   no LLM&#xa;verify_report_v2: body [N] not in the paper set, references with no quote, quote vs paper text by&#xa;fuzzy match (threshold 0.75) — plus informational gene-whitelist and p-value checks&#xa;redact_unverified_v2 deletes the failed sentences and entries and appends a visible removal note&#xa;renumber_citations → [1..k] in order of appearance → sort_references_section" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="900" y="1310" width="620" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="P7" value="save_papers + save_progress(status='done', percent=100,&#xa;detail='Ready — X of Y retrieved papers cited (Z with full text)',&#xa;report, verification, stats)   →  the browser's next poll sees 'done'" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="900" y="1460" width="620" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="P_err" value="&lt;b&gt;Failure paths&lt;/b&gt;&#xa;InterruptedError (cancel flag, checked at every phase boundary) → status 'cancelled'&#xa;any exception, including the 2700 s deadline and 'all synthesis drafts failed' → status 'error' + detail&#xa;no progress written for 10 min → the status route itself marks the job errored (the widget offers Retry)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="120" y="1420" width="620" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="q0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="P0" target="P_ctx">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="q1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="P_ctx" target="P_dec">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="q2" value="no  (default)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="P_dec" target="P1">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="q3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="P_dec" target="P_clu">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="q4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="P_clu" target="P_clu2">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="q5" value="wider pathway set,&#xa;triage skipped" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="P_clu2" target="P2">
