        <mxCell id="L1" value="Browser  —  ExtJS 4.2.1 client" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;horizontal=1;pointerEvents=0;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="120" y="40" width="1200" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="A1" value="PA_Step1Views.js&#xa;&#xa;'Enable AI pathway interpretation'&#xa;checkbox (aiConsent) + experiment&#xa;design textarea (2000 chars) +&#xa;'Draft this for me' button" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="L1">
          <mxGeometry x="20" y="50" width="270" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="A2" value="JobController.js&#xa;&#xa;Step 2 callback: if aiConsent,&#xa;POST /ai_interpret_initiate&#xa;{jobID, experimentDesign}" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="L1">
          <mxGeometry x="310" y="50" width="270" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="A3" value="PA_Step3Views.js&#xa;&#xa;refreshAIWidget() + pollAIStatus()&#xa;self-rescheduling every 3 s&#xa;(x2 backoff to 30 s on error)&#xa;'AI pathway clusters' network colouring" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="L1">
          <mxGeometry x="600" y="50" width="270" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="A4" value="PA_AIInterpretView.js&#xa;&#xa;floating widget: progress bar →&#xa;marked.parse → _sanitizeHtml →&#xa;[N] → PubMed links, pathway +&#xa;cluster links, citations, chat box" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="L1">
          <mxGeometry x="890" y="50" width="270" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="L2" value="Flask server  —  src/servlets/AIInterpretServlet.py" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;horizontal=1;pointerEvents=0;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="120" y="300" width="1200" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="B_async" value="Pipeline routes (async)&#xa;/ai_interpret_initiate → enqueue&#xa;/ai_interpret_status → progress&#xa;/ai_interpret_report → stored report" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="L2">
          <mxGeometry x="20" y="50" width="380" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="B_live" value="In-request routes (no queue)&#xa;/ai_interpret_chat → LLMClient +&#xa;     CHAT_TOOLS over job data&#xa;/ai_interpret_pathway → single-pathway&#xa;     report, cached per pathway" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="L2">
          <mxGeometry x="410" y="50" width="380" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="B_info" value="Support routes&#xa;/ai_provider (unauthenticated:&#xa;     operator + host shown in the UI)&#xa;/ai_generate_exp_design → drafts the&#xa;     design text from data-file headers" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="L2">
          <mxGeometry x="800" y="50" width="380" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="B_gate" value="Gates on every route:  isValidUser(userID, sessionToken)  ·  AI_INTERPRETATION_ENABLED  ·&#xa;LLM key present  ·  jobInstance.getAIConsent()   (no consent → nothing leaves the server)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="L2">
          <mxGeometry x="20" y="190" width="770" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="B_queue" value="PySiQ queue (vendored, in-process)&#xa;enqueue(run_ai_agent, job_id='ai_'+jobID,&#xa;timeout=900) — idempotent per job" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="L2">
          <mxGeometry x="810" y="190" width="370" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="L3" value="AI agent orchestrator  —  src/classes/AIInterpret/agent.py  (OpenAI Agents SDK)" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;horizontal=1;pointerEvents=0;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="120" y="650" width="1200" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="C_work" value="run_agent_workflow() / _run_async()&#xa;owns its own asyncio loop; six phases (page 2)&#xa;wait_for(AI_MAX_RUN_SECONDS = 2700 s)&#xa;bounded() 600 s per long call, run_hedged() 45 s x2" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="L3">
          <mxGeometry x="20" y="50" width="570" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="C_runai" value="run_ai_agent()  ← the queued callable&#xa;AIInterpretDAO progress · _Heartbeat thread (30 s&#xa;touch) · semaphore AI_MAX_CONCURRENT_PIPELINES=2&#xa;_cancel_flags · hooks{progress, cancelled, pathways, partition}" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="L3">
          <mxGeometry x="610" y="50" width="570" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="C_shim" value="configure_sdk(): AsyncOpenAI with chat.completions.create monkey-patched  —  every call is STREAMED (a non-streamed&#xa;call on the CSIC gateway dies at ~120 s), paced to AI_LLM_MAX_RPM, retried 4x on 5xx/408/409/timeout and 8x on 429" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="L3">
          <mxGeometry x="20" y="180" width="1160" height="80" as="geometry"/>
        </mxCell>
