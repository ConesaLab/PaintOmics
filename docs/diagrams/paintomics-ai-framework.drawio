  <diagram id="4._How_a_citation_earns_its_place" name="4. How a citation earns its place">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t4" value="How a citation earns its place in the report" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="160" y="-110" width="1300" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="t4b" value="Page 4 of 4 · every guard between 'the model wrote [12]' and 'the reader sees [12]'" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="160" y="-66" width="1300" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="V1" value="&lt;b&gt;A paper enters the run&lt;/b&gt;&#xa;PubMed ESearch hit → abstract via EFetch → Paper Filter agent keeps it →&#xa;global ref_index assigned → full text fetched from PMC or Europe PMC.&#xa;Methods and Supplementary sections are deliberately dropped." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="40" width="900" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="V2" value="&lt;b&gt;The interpretation batch writes a claim&lt;/b&gt;&#xa;The Pathway Interpreter may only cite the ref_index values it was handed, and may only&#xa;name genes present in the data (gene whitelist)." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="160" y="170" width="900" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="V3" value="&lt;b&gt;Synthesis writes the report with [N] markers&lt;/b&gt;&#xa;The Report Writer is given a master reference list and the valid index range." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="160" y="300" width="900" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="V4" value="&lt;b&gt;Marker hygiene — deterministic&lt;/b&gt;&#xa;normalize_citation_markers: '[17, 18]' and '[17-19]' become separate '[17]', '[18]' markers,&#xa;so every later reader sees them. resolve_pmid_mentions rewrites '(PMID 12345678)' into [N]." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="430" width="900" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="V5" value="&lt;b&gt;Quote collection — 1 LLM call per cited paper&lt;/b&gt;&#xa;For each cited reference: 'give the single verbatim sentence from this paper that supports&#xa;this claim'. No support → no quote. The answer is snapped back onto the source text." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="160" y="560" width="900" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="V6" value="&lt;b&gt;Canonical references — deterministic&lt;/b&gt;&#xa;render_references_section throws away whatever References the model wrote and rebuilds&#xa;'### References' from the paper index: author, title, journal, year, PMID, then&#xa;'**Cited Text:** &quot;quote&quot;' and '*Cited from: abstract / full text (results)*'." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="690" width="900" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="V7" value="&lt;b&gt;Claim Verifier, one per citation, up to 3 rounds&lt;/b&gt;&#xa;A separate agent with search_paper_text / fetch_paper_section reads the paper and returns&#xa;{text_match, supports_claim, reasoning, actual_text, suggested_fix}. Unparseable = failed.&#xa;Failures go back to the Report Writer as a correction prompt; the loop stops when a round&#xa;makes no progress." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="160" y="820" width="900" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="V8" value="&lt;b&gt;verify_report_v2 — the programmatic net&lt;/b&gt;&#xa;Invalid [N]? Reference with no quote? Quote absent from the paper (exact → normalised →&#xa;sliding-window difflib ratio &gt;= 0.75)? Each failure is recorded, not argued with." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="160" y="970" width="900" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="V9" value="&lt;b&gt;redact_unverified_v2&lt;/b&gt;&#xa;Every sentence containing a failed [N] is deleted, its reference entry is deleted, and the&#xa;report gains a visible '&gt; **Note:** N citation(s) with unverified references were removed.'" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="160" y="1100" width="900" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="V10" value="&lt;b&gt;renumber_citations → sort_references_section&lt;/b&gt;&#xa;Surviving markers become [1..k] in order of first appearance; reference entries are reordered&#xa;to match; the paper list sent to the client is relabelled the same way." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="160" y="1230" width="900" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="V11" value="&lt;b&gt;The browser renders it&lt;/b&gt;&#xa;[N] becomes a PubMed link via ref_index → PMID; each citation is listed as&#xa;'full text read' or 'abstract read'; pathway names and C01.. cluster ids become links." style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;align=left;spacingLeft=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="160" y="1360" width="900" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="v_V1_V2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="V1" target="V2">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="v_V2_V3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="V2" target="V3">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="v_V3_V4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="V3" target="V4">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="v_V4_V5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="V4" target="V5">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="v_V5_V6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="V5" target="V6">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="v_V6_V7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="V6" target="V7">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="v_V7_V8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="V7" target="V8">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="v_V8_V9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="V8" target="V9">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="v_V9_V10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="V9" target="V10">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="v_V10_V11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="V10" target="V11">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="V_side1" value="What is NOT enforced&#xa;&#xa;• The gene-symbol whitelist check and the p-value plausibility check are informational:&#xa;   they move a composite score, they never redact.&#xa;• Pathway names in the prose are not verified against the job; the client links them&#xa;   by matching names, ids and aliases.&#xa;• A claim with no citation at all is not challenged by this machinery." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1120" y="40" width="460" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="V_side2" value="Why it is built this way&#xa;&#xa;• The model is never trusted with the reference list — it is regenerated from retrieved&#xa;   metadata, so a fabricated paper cannot survive.&#xa;• The verifier keeps its tools instead of a typed output: with both, vLLM's grammar&#xa;   forced JSON first and the agent returned supports_claim=true having read nothing.&#xa;• Fuzzy matching (0.75) is the last word because an LLM verdict can be wrong in either&#xa;   direction; a quote that is not in the paper is a fact, not an opinion." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1120" y="280" width="460" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="leg_4. " value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="560" width="330" height="130" as="geometry"/>
        </mxCell>
