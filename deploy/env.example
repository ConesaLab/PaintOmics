# PaintOmics AI deployment environment.
#
#   cp deploy/env.example deploy/.env
#
# deploy/.env holds live credentials and is gitignored. Never commit it.
# Every value here is read by deploy/compose.yaml and passed to the app
# container, where example_serverconf.py picks it up.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# The externally reachable URL. This is embedded in account-activation emails,
# so a localhost value silently breaks registration for real users.
# On Drago before DNS exists, use the bare IP: https://203.0.113.10
PAINTOMICS_BASE_URL=https://203.0.113.10

# The logo shown in outgoing email, as a path under PAINTOMICS_BASE_URL.
# Leave it unset unless you are branding a private deployment. It must be a
# raster -- Gmail and every Outlook build refuse an <img> whose source is SVG.
#PAINTOMICS_LOGO_PATH=/resources/images/paintomics-mark-email.png

# The domain guest accounts are named under: they are stored as
# "guest<n>@<this>". Left unset it is derived from PAINTOMICS_BASE_URL, while
# the client shows the user the address from a hardcoded constant in
# ServerConfiguration.js -- so changing the base URL alone splits the stored
# address from the displayed one, with no error either side.
#PAINTOMICS_EMAIL_DOMAIN=paintomics.org

# ---------------------------------------------------------------------------
# Email (SendGrid SMTP)
# ---------------------------------------------------------------------------
# Without SMTP_PASSWORD, registration and password-reset mail cannot be sent and
# new users cannot activate their accounts. The app still starts.
EMAIL_FROM_ADDRESS=noreply@example.org
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=

# Where admin error reports and "please add this organism" requests are sent.
# Unset means they are generated and then delivered nowhere.
EMAIL_REPORT_RECIPIENTS=

# ---------------------------------------------------------------------------
# AI interpretation
# ---------------------------------------------------------------------------
# Provider is the CSIC LLM gateway (free for CSIC users, OpenAI-compatible).
# Tokens are self-service from https://console.llm.iiia.es via CSIC SSO.
#
# The model is pinned to a dated snapshot rather than the "default/llm" alias:
# the service asks scientific users to name an explicit model for
# reproducibility, and an alias can be repointed under a running deployment.
AI_INTERPRETATION_ENABLED=true
AI_LLM_PROVIDER=csic
AI_CSIC_API_BASE=https://llm.iiia.es/v1
AI_CSIC_API_KEY=
AI_CSIC_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Asked, in order, when AI_CSIC_MODEL is not being served -- a 5xx, a dead
# backend, a timeout; never a 4xx that every model would answer alike, and
# never a 429. "default/llm" is the gateway's own alias, kept pointed at a
# working model by its operator. A model that failed is skipped for five
# minutes, then the pinned one is tried first again. Each result records the
# model that actually answered. Empty switches the fallback off.
AI_CSIC_FALLBACK_MODELS=default/llm

# The AI input converter: rewrites an upload the analysis cannot read (a
# DESeq2 table, a MaxQuant output, a workbook) into the matrix PaintOmics
# accepts, in the user's browser, with one gateway call per attempt. The code
# defaults it to off because it draws on the same gateway quota as the
# interpretation; a deployment that has a key wants it on, or every workbook a
# user picks ends in "AI file conversion is not enabled on this server".
AI_INPUT_CONVERTER=true

# Which interpretation arm runs. All three are OFF in the code's own defaults,
# and this file ships them off. paintomics.org sets all three to 1: clustered
# interpretation, the full agent loop, and the Results-section view. Set them
# here rather than only in compose -- compose's environment block is an
# allowlist, so a value this file does not name never reaches the container.
AI_CLUSTER_MODE=0
AI_FULL_AGENT=0
AI_AGENT_RESULTS_SECTION=0

# ---------------------------------------------------------------------------
# PubMed (NCBI E-utilities)
# ---------------------------------------------------------------------------
# A contact address is requested by NCBI. With an API key the rate limit is
# 10 req/s instead of 3.
AI_PUBMED_EMAIL=
AI_PUBMED_API_KEY=
